# Lokale Entwicklung: einfache Datei reicht aus
# Produktion (z.B. Turso): "libsql://<db-name>-<org>.turso.io"
DATABASE_URL="file:./prisma/dev.db"

# Nur nötig, wenn DATABASE_URL auf Turso/libSQL-Remote zeigt
TURSO_AUTH_TOKEN=""

# Basis-Passwortschutz für die gehostete App (HTTP Basic Auth)
APP_BASIC_AUTH_USER="admin"
APP_BASIC_AUTH_PASSWORD="bitte-aendern"

# Bankanbindung zur Mietzahlungsprüfung (GoCardless Bank Account Data, PSD2).
# Kostenloser Account: https://bankaccountdata.gocardless.com
# Ohne diese Werte funktioniert die App normal, nur "Zahlungen" bleibt deaktiviert.
GOCARDLESS_SECRET_ID=""
GOCARDLESS_SECRET_KEY=""
