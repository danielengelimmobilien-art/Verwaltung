// Prisma Schema für die Immobilien-Verwaltung
// Provider "sqlite" wird sowohl lokal (Datei) als auch produktiv über
// Turso/libSQL genutzt (gleicher Adapter, siehe src/lib/prisma.ts) -
// dadurch entfällt ein Wechsel des Providers beim Deployment.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Ein Objekt = eine Immobilie (einzelne Eigentumswohnung oder ganzes Mehrfamilienhaus)
model Objekt {
  id       String @id @default(cuid())
  name     String
  strasse  String
  plz      String
  ort      String

  /// Lagebeschreibung / Mikrolage des Objekts (z.B. "ruhige Seitenstraße, gute Anbindung")
  lage String?

  baujahr   Int?
  kaufpreis Float?
  kaufdatum DateTime?

  /// Finanzierung / Bankdarlehen
  darlehenssumme    Float?
  zinssatzProzent   Float?
  tilgungProzent    Float?
  bankrateMonatlich Float?
  bankName          String?

  notizen String?

  wohnungen   Wohnung[]
  sanierungen Sanierung[]
  kontakte    Kontakt[]
  bankkonten  Bankkonto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

/// Eine Wohnung innerhalb eines Objekts (bei Einzel-ETW: das einzige Wohnung-Objekt-Paar)
model Wohnung {
  id       String @id @default(cuid())
  objektId String
  objekt   Objekt @relation(fields: [objektId], references: [id], onDelete: Cascade)

  bezeichnung String // z.B. "Whg 3" oder "Whg links"

  /// Lage im Objekt, z.B. "2. OG rechts", "EG", "Dachgeschoss"
  lageImObjekt String

  groesseQm Float
  zimmer    Float?

  /// Ziel-Nettokaltmiete pro qm, zum Abgleich mit der aktuellen Miete
  zielmieteProQm Float?

  notizen String?

  mietverhaeltnisse Mietverhaeltnis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objektId])
}

/// Ein Mietverhältnis (aktuell oder historisch) für eine Wohnung
model Mietverhaeltnis {
  id        String  @id @default(cuid())
  wohnungId String
  wohnung   Wohnung @relation(fields: [wohnungId], references: [id], onDelete: Cascade)

  mieterName   String
  telefon      String?
  email        String?
  einzugsdatum DateTime
  auszugsdatum DateTime?

  kaution Float?

  /// aktuelle Nettokaltmiete
  kaltmiete Float

  /// Betriebskosten-Vorauszahlung (ohne Heizung)
  betriebskostenVorauszahlung Float?

  /// Heizkosten-Vorauszahlung
  heizkostenVorauszahlung Float?

  aktiv Boolean @default(true)

  notizen String?

  mieterhoehungen  Mieterhoehung[]
  kontobewegungen  Kontobewegung[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wohnungId])
}

/// Historie der Mieterhöhungen zu einem Mietverhältnis
model Mieterhoehung {
  id                String          @id @default(cuid())
  mietverhaeltnisId String
  mietverhaeltnis   Mietverhaeltnis @relation(fields: [mietverhaeltnisId], references: [id], onDelete: Cascade)

  datum         DateTime
  alteKaltmiete Float
  neueKaltmiete Float
  grund         String?

  createdAt DateTime @default(now())

  @@index([mietverhaeltnisId])
}

/// Modernisierungs- / Sanierungsmaßnahme an einem Objekt
model Sanierung {
  id       String @id @default(cuid())
  objektId String
  objekt   Objekt @relation(fields: [objektId], references: [id], onDelete: Cascade)

  titel     String
  kategorie String // Dach, Fassade, Fenster, Heizung, Elektrik, Bad, Sonstiges
  datum     DateTime

  beschreibung String?
  kosten       Float?

  /// geplant | in_arbeit | abgeschlossen
  status String @default("geplant")

  /// Ablage-Hinweis / Dateiname für zugehörige Belege (manuell gepflegt)
  belegHinweis String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objektId])
}

/// Kontakt für Gewerke / Dienstleister (z.B. Elektrik, Hausverwaltung).
/// Ohne objektId = portfolioweit gültig (z.B. genereller Elektriker),
/// mit objektId = nur für dieses eine Objekt relevant (z.B. Hausverwaltung einer ETW).
model Kontakt {
  id        String  @id @default(cuid())
  kategorie String // Elektrik, Gas/Wasser/Sanitär, Dachdecker, Schornsteinfeger, Hausverwaltung, Sonstiges

  name            String // Firma oder Name
  ansprechpartner String?
  telefon         String?
  email           String?
  adresse         String?
  notizen         String?

  objektId String?
  objekt   Objekt? @relation(fields: [objektId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objektId])
  @@index([kategorie])
}

/// Verbundenes Bankkonto (über GoCardless Bank Account Data / PSD2) zur
/// automatischen Prüfung eingehender Mietzahlungen.
/// Ohne objektId = portfolioweit (Konto sammelt Mieten mehrerer Objekte),
/// mit objektId = nur für dieses eine Objekt relevant.
model Bankkonto {
  id String @id @default(cuid())

  bezeichnung     String // Anzeigename, z.B. "Sparkasse Girokonto"
  institutionId   String? // GoCardless institution id
  institutionName String?
  iban            String?
  kontoinhaber    String?

  /// GoCardless requisition id (Verbindungsvorgang)
  requisitionId String?
  /// GoCardless account id (nach erfolgreicher Verbindung)
  gocardlessAccountId String?

  /// ausstehend | verbunden | fehler | getrennt
  status String @default("ausstehend")
  fehler String?

  letzterSync DateTime?

  objektId String?
  objekt   Objekt? @relation(fields: [objektId], references: [id], onDelete: SetNull)

  kontobewegungen Kontobewegung[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objektId])
}

/// Einzelne Buchung eines verbundenen Bankkontos, ggf. einem Mietverhältnis
/// zur Zahlungsprüfung zugeordnet (automatisch per Betrag/Name oder manuell).
model Kontobewegung {
  id          String    @id @default(cuid())
  bankkontoId String
  bankkonto   Bankkonto @relation(fields: [bankkontoId], references: [id], onDelete: Cascade)

  /// GoCardless transactionId (Deduplizierung beim Sync)
  externeId String

  datum            DateTime
  betrag           Float
  waehrung         String  @default("EUR")
  verwendungszweck String?
  absender         String? // debtorName bei Zahlungseingängen

  mietverhaeltnisId String?
  mietverhaeltnis   Mietverhaeltnis? @relation(fields: [mietverhaeltnisId], references: [id], onDelete: SetNull)

  automatischZugeordnet Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([bankkontoId, externeId])
  @@index([bankkontoId])
  @@index([mietverhaeltnisId])
}

/// Textvorlage für wiederkehrende Schreiben (z.B. Mahnung, Mieterhöhung).
/// Inhalte werden vom Nutzer selbst gepflegt.
model Textvorlage {
  id String @id @default(cuid())

  titel     String
  kategorie String // Mahnung, Mieterhöhung, Kündigungsbestätigung, Nebenkostenabrechnung, Wohnungsübergabe, Willkommen/Einzug, Sonstiges
  inhalt    String
  notizen   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kategorie])
}
